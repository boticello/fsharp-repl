<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
    <RootNamespace>FsRepl</RootNamespace>
    <!-- JsonNode indexer writes are null-valued by design (JSON null); the
         nullness analysis has nothing useful to say about this file. -->
    <NoWarn>$(NoWarn);FS3261</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" Version="10.1.401" />
    <PackageReference Include="FSharp.Compiler.Service" Version="43.12.401" />
  </ItemGroup>

</Project>
